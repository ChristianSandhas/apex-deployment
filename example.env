# Nach .env kopieren und anpassen:  cp example.env .env
APEX_IMAGE=ghcr.io/christiansandhas/apex
APEX_VERSION=v0.1.0
SITE_NAME=erp.example.com
DB_PASSWORD=bitte-aendern
ADMIN_PASSWORD=bitte-aendern
HTTP_PORT=8080
# DB-Port auf dem Host. Unbelassen gilt der Standard des gewaehlten Overrides
# (MariaDB 3306, Postgres 5432) — nur setzen, wenn ein anderer Host-Port noetig ist.
#DB_PORT=3306
# DB_BIND=127.0.0.1 = nur lokal/SSH-Tunnel,
# DB_BIND=0.0.0.0 = im Netzwerk erreichbar (Firewall beachten!)
DB_BIND=127.0.0.1
